# ==============================================================================
# LàmViệc360 Company / Employer Web - Environment Configuration Example
# ==============================================================================

# Active Environment: local | develop | production
NEXT_PUBLIC_ENVIRONMENT=local

# Dev Server Port
PORT=3002

# ------------------------------------------------------------------------------
# Local Environment (Default fallback when NEXT_PUBLIC_ENVIRONMENT=local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_LOCAL_API_TARGET=http://localhost:8002
NEXT_PUBLIC_LOCAL_BASE_URL=http://localhost:8002/api/v1/company
NEXT_PUBLIC_LOCAL_S3_IMAGE_BASE_URL=http://localhost:8002/uploads
NEXT_PUBLIC_LOCAL_SEEKER_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Develop Environment (Active when NEXT_PUBLIC_ENVIRONMENT=develop)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEVELOP_API_TARGET=https://devapi.lamviec360.com
NEXT_PUBLIC_DEVELOP_BASE_URL=https://devapi.lamviec360.com/api/v1/company
NEXT_PUBLIC_DEVELOP_S3_IMAGE_BASE_URL=https://devapi.lamviec360.com/uploads
NEXT_PUBLIC_DEVELOP_SEEKER_URL=https://devjobseeker.lamviec360.com

# ------------------------------------------------------------------------------
# Production Environment (Active when NEXT_PUBLIC_ENVIRONMENT=production)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PRODUCTION_API_TARGET=https://api.lamviec360.com
NEXT_PUBLIC_PRODUCTION_BASE_URL=https://api.lamviec360.com/api/v1/company
NEXT_PUBLIC_PRODUCTION_S3_IMAGE_BASE_URL=https://api.lamviec360.com/uploads
NEXT_PUBLIC_PRODUCTION_SEEKER_URL=https://lamviec360.com

# ------------------------------------------------------------------------------
# Global Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_TIMEOUT=30000

# Optional Direct Overrides (uncomment to explicitly override active environment)
# NEXT_PUBLIC_API_URL=http://localhost:8002/api/v1/company
# NEXT_PUBLIC_SEEKER_URL=http://localhost:3001
